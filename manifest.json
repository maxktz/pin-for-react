{
  "manifest_version": 3,
  "name": "React Pin",
  "version": "0.1.0",
  "description": "Point at UI and hand it to a coding agent: copy an element, or pin feedback on several and copy them as one prompt.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "React Pin: show or hide on this site",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "http://*.localhost/*", "https://*.localhost/*"],
      "js": ["pin.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "111"
}
